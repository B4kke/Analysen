NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
DATABASE_URL=postgresql+asyncpg://analysen:analysen@localhost:5432/analysen
REDIS_URL=redis://localhost:6379/0
SEARXNG_BASE_URL=http://localhost:8080
RAW_EVIDENCE_DIR=./data/raw
MODEL_CONFIG_PATH=./config/models.yaml
SOURCE_CONFIG_PATH=./config/sources.yaml
POLICY_CONFIG_PATH=./config/policies.yaml
LOG_LEVEL=INFO
SEARXNG_SECRET=replace-with-a-local-secret
POSTGRES_PORT=5432
REDIS_PORT=6379
SEARXNG_PORT=8080
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# LAN-tilgang (f.eks. mobil på samme nett): bind web/API på alle grensesnitt.
# Krever at CORS_ORIGINS inneholder telefonens opprinnelse (kun RFC1918-adresser
# godtas), og at web bygges med LAN-adressen til API-et (se DEPLOYMENT.md).
# Kun klarerte nett — ingen auth (ADR-017).
# BIND_ADDRESS=0.0.0.0
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.10:3000
